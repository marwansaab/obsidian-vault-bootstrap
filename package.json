{
  "name": "@marwansaab/obsidian-vault-bootstrap",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "bin": {
    "obsidian-vault-bootstrap": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
